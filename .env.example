# Copy to .env for local development. Never commit .env.
# In production every secret below comes from a secret manager or Docker secrets
# (set NAME_FILE=/run/secrets/name instead of NAME); see docs/DEPLOYMENT.md.

NODE_ENV=development
PORT=3000
# text locally, json in production (one JSON object per line). LOG_LEVEL: error | warn | log | debug
LOG_FORMAT=text
LOG_LEVEL=log

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=jali
DB_PASSWORD=jali_secret
DB_DATABASE=jali

# Creates/updates tables from the entities on boot. Local practice only.
# Production: DB_SYNCHRONIZE=false and run `pnpm migration:run` (or DB_MIGRATIONS_RUN=true).
DB_SYNCHRONIZE=true
DB_MIGRATIONS_RUN=false

# At least 32 random characters in production: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# --- Payment providers ---------------------------------------------------------
# simulator: no network; settle requests with `pnpm callback:send`.
# http: real calls to MTN / Airtel (their sandboxes or production hosts).
PAYMENT_PROVIDER_MODE=simulator
PROVIDER_TIMEOUT_MS=10000
# Public https URL of POST /api/payments/callbacks (required when PAYMENT_PROVIDER_MODE=http).
PAYMENT_CALLBACK_URL=

# Credentials the providers use to call US back. Secrets: at least 32 characters.
MTN_CALLBACK_TOKEN=local-mtn-callback-token
MTN_CALLBACK_SECRET=local-mtn-callback-signing-secret-change-me
AIRTEL_CALLBACK_TOKEN=local-airtel-callback-token
AIRTEL_CALLBACK_SECRET=local-airtel-callback-signing-secret-change
# Max clock difference allowed on X-Timestamp (replay protection).
CALLBACK_TOLERANCE_SECONDS=300

# Credentials WE use to call the providers (only with PAYMENT_PROVIDER_MODE=http).
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_TARGET_ENVIRONMENT=sandbox
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

# Reconciliation job: asks providers about PENDING payments. 0 disables it.
RECONCILIATION_INTERVAL_MS=60000
PENDING_EXPIRY_HOURS=24

# --- HTTP ----------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (the Next.js app).
CORS_ORIGINS=http://localhost:3001
# Set to 1 behind one reverse proxy / load balancer.
TRUST_PROXY=
# Swagger UI is on outside production; set true to expose it in production too.
SWAGGER_ENABLED=false
